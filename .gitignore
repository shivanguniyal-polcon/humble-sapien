# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# API keys for the PIT pipeline — never commit these
.env
.env.*
!.env.example
pit_pipeline.py.key
*.secret

# Pipelines cache downloaded source material here. It is reproducible from
# the sources and it is large — 97MB of it — so it never enters the repo.
scripts/.cache/

# Reference PDFs bought or downloaded for research. They are not ours to
# redistribute and they are tens of megabytes.
*.pdf

# Internal commercial documents — never committed, never pushed. Pricing
# floors, revenue targets, decision logs and governance notes live here on
# disk only. Keeping them out of git keeps the engine public without
# publishing the negotiating position.
private/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
