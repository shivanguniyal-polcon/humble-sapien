# Security headers for the deployed site.
#
# These mirror what vercel.json set before the move, so the migration does not
# quietly drop a control. Cloudflare parses this file instead of serving it.
#
# One addition to the old policy: connect-src also names the RARA API. The
# previous policy was written before that Worker existed, and a policy that
# blocks it would fail in the browser with no server-side error to find.
#
# Fingerprinted build output is immutable under its own name. Pin /assets so a
# repeat visit reuses the JS, CSS and workers instead of spending a round trip
# revalidating each one; the HTML stays revalidated so a deploy is picked up.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The mobile font subsets are content-stable; rename them if they change.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://ths-monitor-api.shivang-uniyal27.workers.dev https://ths-places-api.shivang-uniyal27.workers.dev https://ths-rara-tracker.shivang-uniyal27.workers.dev; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
X-Content-Type-Options: nosniff
X-Frame-Options: DENY
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
Strict-Transport-Security: max-age=63072000; includeSubDomains
X-XSS-Protection: 0
